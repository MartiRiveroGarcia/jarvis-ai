# Copy this file to .env and adjust the values for your machine.
# .env is ignored by Git: never commit real secrets.

# Display name used in the API docs and health response.
JARVIS_APP_NAME=Jarvis API

# One of: development, test, production.
JARVIS_ENVIRONMENT=development

# Session lifetime in days (1-90). Sessions are not extended by activity.
JARVIS_SESSION_TTL_DAYS=7

# Allow public registration. Create your account, then set this to false in production.
JARVIS_REGISTRATION_ENABLED=true

# SQLAlchemy database URL. Note: this variable has NO JARVIS_ prefix.
# Leave it unset to use the default SQLite file: backend/jarvis.db
# A PostgreSQL URL contains credentials — set it only in your local .env or
# the deployment environment, never in this file.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/jarvis
